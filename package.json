{
  "name": "property-insights",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-insurance-copy.ts && tsx scripts/journey-matrix.ts --check && tsx scripts/validate-insurance-kernel-execution.ts && tsx scripts/validate-insurance-a1-domain.ts && tsx scripts/test-insurance-case-portal.ts && tsx scripts/test-auth-ownership.ts && tsx scripts/insurance-migrate.ts --mode=plan && tsx scripts/generate-sitemap.ts",
    "journey:generate": "tsx scripts/journey-matrix.ts",
    "journey:check": "tsx scripts/journey-matrix.ts --check",
    "journey:table": "tsx scripts/journey-matrix.ts --table",
    "insurance-kernel:check": "tsx scripts/validate-insurance-kernel-execution.ts",
    "insurance-a1:check": "tsx scripts/validate-insurance-a1-domain.ts && tsx scripts/test-insurance-case-portal.ts",
    "auth:check": "tsx scripts/test-auth-ownership.ts",
    "insurance:migrate:plan": "tsx scripts/insurance-migrate.ts --mode=plan",
    "insurance:migrate:check": "tsx scripts/insurance-migrate.ts --mode=check",
    "insurance:migrate:apply": "tsx scripts/insurance-migrate.ts --mode=apply",
    "insurance:migrate:test": "node --import tsx scripts/test-insurance-migrations.ts",
    "insurance:backfill:dry-run": "tsx scripts/backfill-insurance-cases.ts",
    "smoke:prod": "tsx scripts/prod-smoke.ts",
    "test:sitemap-lastmod": "tsx scripts/test-sitemap-lastmod.ts",
    "test:regional-econ-stamping": "node --import tsx scripts/test-regional-econ-stamping.ts",
    "security:audit": "node scripts/check-production-advisories.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clerk/nextjs": "7.8.0",
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.2",
    "openai": "^6.27.0",
    "posthog-js": "^1.417.1",
    "posthog-node": "^5.49.1",
    "puppeteer-core": "25.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.21.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
