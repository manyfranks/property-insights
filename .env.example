# ============================================================
# Property Insights — Environment Variables
# Copy to .env.local and fill in your keys
# ============================================================

# --- PRIORITY 1: Core functionality ---

# LLM — description analysis, offer narratives, address normalization
# Sign up: https://openrouter.ai/keys
# Cost: ~$0.02/analysis (Sonnet for analysis, Haiku for normalization)
OPENROUTER_API_KEY=

# HTTP proxy — routes realtor.ca requests past Cloudflare
# Sign up: https://www.scraperapi.com/signup
# Cost: Free tier 1,000 calls/mo, $49/mo for 100K
SCRAPER_API_KEY=

# Headless browser — live BC Assessment lookup (React SPA scraping)
# Sign up: https://www.browserless.io/sign-up
# Cost: Free tier 1,000 sessions/mo
BROWSERLESS_API_KEY=

# Google Places — address autocomplete (/api/autocomplete)
# Sign up: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# --- PRIORITY 2: Database + cron ---

# Neon Postgres — primary data store (src/lib/db/index.ts)
# Sign up: https://neon.tech
DATABASE_URL=

# Shared secret required by Vercel Cron to call /api/pipeline/refresh and /api/db/migrate
CRON_SECRET=

# --- PRIORITY 3: Production caching ---

# Vercel KV (Redis) — auto-populated when linked in Vercel Dashboard
# Go to: Vercel Dashboard > Storage > Create KV Database > Link to project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- PRIORITY 4: Auth + Email ---

# Clerk — authentication (sign in modal, user metadata for subscriptions)
# Sign up: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Fallback sign-in target for the static header link shown when clerk-js
# fails to load (src/components/clerk-boundary.tsx). Point it at a hosted
# sign-in page. Unset falls back to the home page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=

# Resend — transactional email (city digest alerts)
# Sign up: https://resend.com
RESEND_API_KEY=

# --- PRIORITY 2b: US data (RentCast) ---

# RentCast — US property records, AVM value/rent estimates, active listings
# (src/lib/rentcast.ts). Sign up: https://app.rentcast.io/app/api
# Included allowance: 50 successful requests/month. Every call is cached
# (KV) and quota-guarded; 404s/errors release their reservation because only
# successful HTTP 200 responses count. Values above 50 opt into paid overage.
RENTCAST_API_KEY=
# Optional additional included-allowance credentials. Production consumes
# their remaining free calls before using primary-key paid overage.
RENTCAST_API_KEY_2=
RENTCAST_API_KEY_3=
# Default 50 if unset — uses the included allowance but permits no overage.
RENTCAST_MONTHLY_QUOTA=50
# Per-secondary-key guard; keep at 50 to prevent paid overage on keys 2/3.
RENTCAST_SECONDARY_MONTHLY_QUOTA=50

# --- PRIORITY 5: Site config + affiliate links ---

# Canonical base URL used for metadata, sitemaps, and JSON-LD
# Defaults to https://www.propertyinsights.xyz if unset
NEXT_PUBLIC_BASE_URL=

# --- Insurance kernel execution (server-only; all default disabled) ---
#
# These are intentionally NOT NEXT_PUBLIC variables. They authorize future
# server routes only; the existing affiliate/waitlist experience does not read
# them. Valid modes are SIMULATION, SANDBOX, PRODUCTION. Unset/invalid values
# disable the kernel. VERCEL_ENV=production rejects SIMULATION and SANDBOX;
# VERCEL_ENV=preview may explicitly run synthetic simulation.
INSURANCE_KERNEL_EXECUTION_MODE=
# A0/A1 capability flags: only an exact "1" enables a requested capability.
INSURANCE_KERNEL_ENABLE_PROFILE_CAPTURE=0
# A1 canonical dual-write. Requires PROFILE_CAPTURE=1 and migrated schema.
INSURANCE_KERNEL_ENABLE_CASE_RECORD=0
# A1 factual case-status UI. Requires CASE_RECORD=1 and owner copy approval.
INSURANCE_KERNEL_ENABLE_CASE_PORTAL=0
INSURANCE_KERNEL_ENABLE_QUOTE_REQUEST=0
INSURANCE_KERNEL_ENABLE_CLAIM_INTAKE=0
# Binding is deliberately double-gated and should remain off until a carrier
# delegation agreement and production controls are approved.
INSURANCE_KERNEL_ENABLE_BIND_REQUEST=0
INSURANCE_KERNEL_PRODUCTION_BIND_ACK=

# Privileged release/CI credential only. Never expose to the web runtime.
INSURANCE_MIGRATION_DATABASE_URL=
INSURANCE_MIGRATION_ACTOR=
INSURANCE_MIGRATION_RELEASE_ID=

# Affiliate partner links rendered by src/components/partner-cta.tsx
NEXT_PUBLIC_RATEHUB_URL=
NEXT_PUBLIC_NESTO_URL=
NEXT_PUBLIC_SQUAREONE_URL=

# US affiliate links, one per vendor in src/config/affiliate-vendors.ts
# (NEXT_PUBLIC_AFFILIATE_URL_{ID} pattern — see ENV_URL_MAP in that file).
# Only RENTCAST and DEALCHECK are live; the rest are registered but inert
# (enabled: false) until affiliate approval lands.
NEXT_PUBLIC_AFFILIATE_URL_RENTCAST=
NEXT_PUBLIC_AFFILIATE_URL_DEALCHECK=
NEXT_PUBLIC_AFFILIATE_URL_DEALMACHINE=
NEXT_PUBLIC_AFFILIATE_URL_PROPSTREAM=
NEXT_PUBLIC_AFFILIATE_URL_KIAVI=
NEXT_PUBLIC_AFFILIATE_URL_OWNWELL=
NEXT_PUBLIC_AFFILIATE_URL_ZEBRA=
NEXT_PUBLIC_AFFILIATE_URL_LENDINGTREE=
NEXT_PUBLIC_AFFILIATE_URL_HOMELIGHT=

# --- PRIORITY 2c: US regional-econ ingest (scripts/ingest-us-*.ts) ---

# Census ACS — county-level demographics (median home value, rent, income)
CENSUS_API_KEY=
# HUD — Fair Market Rents by county/bedroom count
HUD_API_KEY=

# --- PRIORITY 6: Pro subscription billing (stripe) ---
# All three must be set for /pricing to offer upgrades — otherwise the
# upgrade button renders disabled ("Coming soon") and the API routes
# return 503. Nothing else about the site changes when these are unset.

# Secret key (sk_...) — server-side Stripe API calls
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) for the webhook endpoint below — get this when
# you register the endpoint in the Stripe dashboard
# Webhook endpoint URL to configure: /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price ID (price_...) for the Pro monthly subscription plan
STRIPE_PRICE_ID_PRO=
