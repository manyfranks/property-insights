# ============================================================
# Property Insights — Environment Variables
# Copy to .env.local and fill in your keys
# ============================================================

# --- PRIORITY 1: Core functionality ---

# LLM — description analysis, offer narratives, address normalization
# Sign up: https://openrouter.ai/keys
# Cost: ~$0.02/analysis (Sonnet for analysis, Haiku for normalization)
OPENROUTER_API_KEY=

# HTTP proxy — routes realtor.ca requests past Cloudflare
# Sign up: https://www.scraperapi.com/signup
# Cost: Free tier 1,000 calls/mo, $49/mo for 100K
SCRAPER_API_KEY=

# Headless browser — live BC Assessment lookup (React SPA scraping)
# Sign up: https://www.browserless.io/sign-up
# Cost: Free tier 1,000 sessions/mo
BROWSERLESS_API_KEY=

# Google Places — address autocomplete (/api/autocomplete)
# Sign up: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# --- PRIORITY 2: Database + cron ---

# Neon Postgres — primary data store (src/lib/db/index.ts)
# Sign up: https://neon.tech
DATABASE_URL=

# Shared secret required by Vercel Cron to call /api/pipeline/refresh and /api/db/migrate
CRON_SECRET=

# --- PRIORITY 3: Production caching ---

# Vercel KV (Redis) — auto-populated when linked in Vercel Dashboard
# Go to: Vercel Dashboard > Storage > Create KV Database > Link to project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- PRIORITY 4: Auth + Email ---

# Clerk — authentication (sign in modal, user metadata for subscriptions)
# Sign up: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend — transactional email (city digest alerts)
# Sign up: https://resend.com
RESEND_API_KEY=

# --- PRIORITY 5: Site config + affiliate links ---

# Canonical base URL used for metadata, sitemaps, and JSON-LD
# Defaults to https://www.propertyinsights.xyz if unset
NEXT_PUBLIC_BASE_URL=

# Affiliate partner links rendered by src/components/partner-cta.tsx
NEXT_PUBLIC_RATEHUB_URL=
NEXT_PUBLIC_NESTO_URL=
NEXT_PUBLIC_SQUAREONE_URL=
