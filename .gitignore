# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# e2e/playwright.config.ts webServer dev-instances — see next.config.ts's
# distDir comment for why these are separate from /.next/
/.next-e2e-*/

# playwright
/playwright-report/
/test-results/
/blob-report/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# keep the example env template tracked
!.env.example

# generated sitemaps — prebuild artifacts written fresh on every deploy by
# scripts/generate-sitemap.ts. They were previously committed, which
# produced a full-file diff on every deploy for no reason (the files are
# reproducible from the DB + static data at build time). sitemap-main.xml is
# a <sitemapindex> (still the URL robots.ts advertises); sitemap.xml is the
# flat legacy merge (static/blog/us only, see generate-sitemap.ts);
# sitemap-{static,blog,us}.xml are the per-surface children it still writes.
#
# sitemap-discover.xml and sitemap-property.xml are listed here too, but as
# of 2026-08-27 the generator no longer writes them at all — they're dynamic
# routes now (src/app/sitemap-{discover,property}.xml/route.ts), kept
# ignored defensively: a stray static file at either path would silently
# SHADOW the dynamic route (Next.js serves public/ before an app route),
# which is exactly the regression scripts/test-sitemap-lastmod.ts and
# scripts/test-listings-degraded.ts guard against. See
# scripts/generate-sitemap.ts for the full rationale.
public/sitemap.xml
public/sitemap-main.xml
public/sitemap-static.xml
public/sitemap-blog.xml
public/sitemap-discover.xml
public/sitemap-property.xml
public/sitemap-us.xml
